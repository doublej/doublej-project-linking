{
  "name": "doublej-project-linking",
  "version": "0.1.0",
  "description": "Embeddable widget with path-based profile matching.",
  "type": "module",
  "bin": {
    "widget-link": "src/cli.ts"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build:widget": "vite build --config vite.config.widget.ts",
    "build:manifest": "bun run scripts/build-manifest.ts",
    "build:static": "bun run build:manifest && bun run build:widget",
    "cli": "bun run src/cli.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
